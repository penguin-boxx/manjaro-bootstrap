{
    "workbench.colorTheme": "Light Modern",
    "haskell.manageHLS": "GHCup",
    "workbench.secondarySideBar.showLabels": false,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 100,
    "security.workspace.trust.untrustedFiles": "open",
    "terminal.integrated.fontLigatures.enabled": true,
    "editor.fontFamily": "'JetBrains Mono', 'monospace', monospace",
    "editor.fontLigatures": true,
    "[haskell]": {"editor.tabSize": 2},
    "[coq]": {"editor.tabSize": 2},
    "editor.tabSize": 4,
    "editor.wordWrap": "on",
    "terminal.integrated.scrollback": 100000,
    "files.trimTrailingWhitespace": true,
    "editor.minimap.showSlider": "always",
    "window.customTitleBarVisibility": "never",
    "http.proxyAuthorization": null,
    "chat.agent.maxRequests": 300,
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://kotlinlang.org/docs/home.html": true,
        "https://kotlinlang.org/docs": true,
        "https://kotlinlang.org": true,
        "https://github.com/jetbrains/kotlin": true,
        "https://github.com/jetbrains": true,
        "https://github.com": true,
        "https://docs.oracle.com": {
            "approveRequest": true,
            "approveResponse": false
        },
        "https://ia.spcras.ru": true
    },
    "chat.viewSessions.orientation": "stacked",
    "editor.fontSize": 11,
    "diffEditor.maxComputationTime": 0,
    "chat.tools.terminal.autoApprove": {
        "pdflatex": true,
        "bibtex": true,
        "awk": true,
        "pdfinfo": true,
        "true": true,
        "pdftotext": true,
        "timeout": true,
        "rocq": true,
        "latexmk": true,
        "make": true
    },
    "claudeCode.preferredLocation": "panel",
    "github.copilot.nextEditSuggestions.enabled": false,
    "latex-workshop.latex.autoBuild.run": "never",
    "[latex]": {
        "editor.defaultFormatter": "mathematic.vscode-latex"
    }
}